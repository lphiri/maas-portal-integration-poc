{
  "realm": "saas",
  "keycloakVersion": "26.8.0",
  "accessTokenLifespan": 21600,
  "ssoSessionIdle": 21600,
  "enabled": true,
  "loginWithEmailAllowed": true,
  "organizationsEnabled": true,
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "name": "Multi-tenant tutorial app",
      "baseUrl": "${KEYCLOAK_HOME_URL}",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${KEYCLOAK_REDIRECT_URI}"],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": ["organization"],
      "protocolMappers": [
        {
          "name": "MaaS tenant groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "MaaS organizations",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_orgs_json",
            "claim.name": "https://redhat\\.com/maas/orgs",
            "jsonType.label": "JSON",
            "multivalued": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "grid-tenant-1",
      "displayName": "Grid Tenant 1",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "hideOnLogin": true,
      "config": {
        "clientId": "saas-broker",
        "clientSecret": "${GRID_TENANT_1_BROKER_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp",
        "authorizationUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/auth",
        "tokenUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/token",
        "userInfoUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/userinfo",
        "logoutUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/logout",
        "jwksUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-1-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile"
      }
    },
    {
      "alias": "grid-tenant-2",
      "displayName": "Grid Tenant 2",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "hideOnLogin": true,
      "config": {
        "clientId": "saas-broker",
        "clientSecret": "${GRID_TENANT_2_BROKER_CLIENT_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp",
        "authorizationUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/auth",
        "tokenUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/token",
        "userInfoUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/userinfo",
        "logoutUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/logout",
        "jwksUrl": "${KEYCLOAK_PUBLIC_URL}/realms/grid-tenant-2-idp/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Grid Tenant 1 groups",
      "identityProviderAlias": "grid-tenant-1",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "groups",
        "user.attribute": "maas_groups",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 1 organizations transport",
      "identityProviderAlias": "grid-tenant-1",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "https://redhat\\.com/maas/orgs",
        "user.attribute": "maas_orgs_json",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 2 groups",
      "identityProviderAlias": "grid-tenant-2",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "groups",
        "user.attribute": "maas_groups",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "Grid Tenant 2 organizations transport",
      "identityProviderAlias": "grid-tenant-2",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "https://redhat\\.com/maas/orgs",
        "user.attribute": "maas_orgs_json",
        "syncMode": "FORCE"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "id": "b5919e8a-046d-47e7-8a2c-f30f5ff12000",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "config-pieces-count": ["1"],
          "config-piece-0": ["{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"]
        }
      }
    ]
  },
  "organizations": [
    {
      "name": "Grid Tenant 1",
      "alias": "grid-tenant-1",
      "enabled": true,
      "domains": [
        {
          "name": "grid-tenant-1.test",
          "verified": false,
          "identityProviderAlias": "grid-tenant-1",
          "autoRedirect": true
        }
      ],
      "identityProviders": [
        {
          "alias": "grid-tenant-1",
          "organizationLinks": [
            {
              "autoMembership": true,
              "membershipType": "UNMANAGED"
            }
          ]
        }
      ]
    },
    {
      "name": "Grid Tenant 2",
      "alias": "grid-tenant-2",
      "enabled": true,
      "domains": [
        {
          "name": "grid-tenant-2.test",
          "verified": false,
          "identityProviderAlias": "grid-tenant-2",
          "autoRedirect": true
        }
      ],
      "identityProviders": [
        {
          "alias": "grid-tenant-2",
          "organizationLinks": [
            {
              "autoMembership": true,
              "membershipType": "UNMANAGED"
            }
          ]
        }
      ]
    }
  ]
}
