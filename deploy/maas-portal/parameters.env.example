workloadNamespace=example-workload
gatewayNamespace=example-ingress
gatewayName=example-gateway
gatewayListenerName=https
publicHostname=portal.example.com
portalServiceName=example-portal
portalServicePort=8443
oidcIssuerUrl=https://sso.example.com/realms/example
oidcClientId=example-client
authProxySecretName=example-auth-proxy-creds
authorinoNamespace=example-authorino
authorinoPodSelector=authorino-resource:example-authorino
portalPathPrefix=/example-portal
portalRewritePrefix=/
oauthPathPrefix=/oauth2
portalRouteName=example-portal-route
oauthRouteName=example-oauth-route
authProxyName=example-auth-proxy
resourceNamePrefix=example-
partOfLabel=example-deploy
clusterDnsDomain=cluster.local
cookieDomain=portal.example.com
authProxyImage=registry.example.com/auth-proxy:1.0.0
authProxyImagePullPolicy=IfNotPresent
authProxyReplicas=1
authProxyCpuRequest=100m
authProxyMemoryRequest=128Mi
authProxyMemoryLimit=128Mi
authProxyTmpSizeLimit=10Mi
authProxyHttpPort=4180
authProxyMetricsPort=9000
cookieName=_example_proxy
cookieExpire=24h0m0s
cookieRefresh=4m0s
cookieSameSite=lax
oidcScopeOpenid=openid
oidcScopeEmail=email
oidcScopeProfile=profile
allowedEmailDomains=example.com
oidcEmailClaim=email
oidcGroupsClaim=groups
jwtCacheTtl=300
sessionCheckTimeout=2s
payloadProcessorPreFilterName=example.filters.http.ext_proc.pre
payloadProcessorFilterName=example.filters.http.ext_proc
payloadBypassPriority=20
usernamePrimaryClaim=preferred_username
usernameFallbackClaim=sub
organizationClaim=https://example.com/maas/orgs
organizationIdPrimaryClaim=organization_id
organizationIdFallbackClaim=tenant_id
organizationRolesClaim=roles
keycloakNamespace=example-sso
keycloakDeployment=example-keycloak
keycloakRealm=example
keycloakImportSecretName=example-keycloak-secrets
keycloakRedirectUriKeyName=EXAMPLE_REDIRECT_URI
brokerTenant1=example-tenant-1
brokerTenant2=example-tenant-2
brokerTenantRealmSuffix=-idp
brokerClientId=example-broker
keycloakAdminUrl=http://localhost:8080
keycloakAdminRealm=master
keycloakAdminUsernameEnv=EXAMPLE_ADMIN_USERNAME
keycloakAdminPasswordEnv=EXAMPLE_ADMIN_PASSWORD
keycloakCliPath=/opt/example/bin/kcadm.sh
gatewayClassName=example-gateway-class
gatewayTlsSecretName=example-tls-secret
gatewayHttpsPort=443
gatewayAllowedRoutes=All
gatewayIstioRevision=example-gateway
debugResourceName=example-debug-httpbin
debugPublicPath=/debug/headers
debugBackendPath=/headers
debugImage=registry.example.com/httpbin:1.0.0
debugPort=8080
debugReplicas=1
debugCpuRequest=10m
debugMemoryRequest=32Mi
debugCpuLimit=100m
debugMemoryLimit=64Mi
