apiVersion: v1
kind: Secret
metadata:
  name: maas-consumer-auth-proxy-creds
  namespace: redhat-ods-applications
type: Opaque
stringData:
  OAUTH2_PROXY_CLIENT_ID: tenant-demo
  OAUTH2_PROXY_CLIENT_SECRET: REPLACE_WITH_OIDC_CLIENT_SECRET
  OAUTH2_PROXY_COOKIE_SECRET: REPLACE_WITH_URLSAFE_BASE64_ENCODED_32_BYTE_SECRET
